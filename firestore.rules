// ============================================================================
//  DREAM MARKET PODCAST — Firestore rules
//  ⚠️  Ha tirtirin rules-ka apps-kaaga kale! Kaliya ku DAR qaybta u dhaxaysa
//      "BEGIN DREAM" iyo "END DREAM" gudaha:  match /databases/{database}/documents { ... }
// ============================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- BEGIN DREAM ----------------
    function dreamAdminPath(id) { return /databases/$(database)/documents/admin-dream/$(id); }

    // username + password are compared HERE (server side) — never sent to browsers
    function dreamValidAdmin(id, u, p) {
      return id is string && exists(dreamAdminPath(id))
        && get(dreamAdminPath(id)).data.username == u
        && get(dreamAdminPath(id)).data.password == p;
    }
    function dreamSessionPath() { return /databases/$(database)/documents/dreamAdminSessions/$(request.auth.uid); }
    function isDreamAdmin() {
      return request.auth != null
        && exists(dreamSessionPath())
        && request.time < get(dreamSessionPath()).data.createdAt + duration.value(7, 'd')
        && dreamValidAdmin(get(dreamSessionPath()).data.adminId,
                           get(dreamSessionPath()).data.username,
                           get(dreamSessionPath()).data.password);
    }

    // Admin accounts: edited only from Firebase Console (nobody can read them from the web)
    // Nobody can read admin passwords from the web. A logged-in admin may change only his own username/password.
    match /admin-dream/{id} {
      allow read, create, delete: if false;
      allow update: if isDreamAdmin()
        && get(dreamSessionPath()).data.adminId == id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['username', 'password'])
        && request.resource.data.username is string && request.resource.data.username.size() >= 3
        && request.resource.data.password is string && request.resource.data.password.size() >= 4;
    }

    // Login session (created only when username + password match admin-dream)
    match /dreamAdminSessions/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.createdAt == request.time
        && dreamValidAdmin(request.resource.data.adminId, request.resource.data.username, request.resource.data.password);
      allow read, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Website content: everyone reads, only admin writes
    match /dreamSettings/{id}  { allow read: if true; allow write: if isDreamAdmin(); }
    match /dreamEpisodes/{id}  { allow read: if true; allow write: if isDreamAdmin(); }
    match /dreamShows/{id}     { allow read: if true; allow write: if isDreamAdmin(); }
    match /dreamGuests/{id}    { allow read: if true; allow write: if isDreamAdmin(); }
    match /dreamPartners/{id}  { allow read: if true; allow write: if isDreamAdmin(); }
    match /dreamTeam/{id}      { allow read: if true; allow write: if isDreamAdmin(); }

    // Visitors send messages / subscribe; only admin reads them
    match /dreamMessages/{id} {
      allow create: if request.resource.data.message is string && request.resource.data.message.size() < 3000
                    && request.resource.data.email is string;
      allow read, update, delete: if isDreamAdmin();
    }
    match /dreamSubscribers/{id} {
      allow create: if request.resource.data.email is string && request.resource.data.email.size() < 200;
      allow read, delete: if isDreamAdmin();
    }
    // Visitor statistics: the website adds counts; counts are public (shown on the homepage)
    match /dreamStats/{id} {
      allow read: if true;
      allow create, update: if (id == 'total' || id.matches('day-[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && request.resource.data.keys().hasOnly(['date', 'visits', 'visitors', 'pageviews', 'mobile', 'desktop', 'sources', 'pages', 'updatedAt']);
      allow delete: if isDreamAdmin();
    }
    // ---------- Competitions ----------
    match /dreamCompetitions/{id} {
      allow read: if true;
      allow create, delete: if isDreamAdmin();
      // admin edits everything; a visitor may only add +1 to "registered" while registration is open and not full
      allow update: if isDreamAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registered'])
        && request.resource.data.registered == resource.data.get('registered', 0) + 1
        && resource.data.get('registrationOpen', false) == true
        && (resource.data.get('maxParticipants', 0) == 0 || request.resource.data.registered <= resource.data.maxParticipants));
    }
    // Registrations (private). Document id = competitionId_deviceId → one registration per device per competition.
    function dreamRegPath(id) { return /databases/$(database)/documents/dreamCompRegs/$(id); }
    function dreamMyRegId(compId) { return compId + '_' + request.auth.uid; }
    match /dreamCompRegs/{id} {
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && id == dreamMyRegId(request.resource.data.compId)
        && request.resource.data.status == 'pending'
        && request.resource.data.agreed == true
        && request.resource.data.fullName is string && request.resource.data.fullName.size() > 3 && request.resource.data.fullName.size() <= 60
        && !request.resource.data.fullName.matches('.*[0-9@#$%^&*_+=<>?/|{}~!:;,].*')
        && request.resource.data.email is string && request.resource.data.email.size() < 130
        && request.resource.data.email.matches('^[a-z0-9._%+-]+@[a-z0-9.-]+[.][a-z]{2,}$')
        && request.resource.data.nameKey is string && request.resource.data.nameKey.size() > 2
        && !('luckyNumber' in request.resource.data)
        // the email and the name must be claimed in the same write (each can be used only once per competition)
        && existsAfter(/databases/$(database)/documents/dreamCompEmails/$(request.resource.data.compId + '_' + request.resource.data.email))
        && existsAfter(/databases/$(database)/documents/dreamCompNames/$(request.resource.data.compId + '_' + request.resource.data.nameKey))
        && get(/databases/$(database)/documents/dreamCompetitions/$(request.resource.data.compId)).data.get('registrationOpen', false) == true;
      // the visitor may add his lucky number once (and only together with claiming that number)
      allow update: if isDreamAdmin() || (
        request.auth != null && resource.data.get('uid', '') == request.auth.uid
        && !('luckyNumber' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['luckyNumber'])
        && existsAfter(/databases/$(database)/documents/dreamLuckyNumbers/$(resource.data.compId + '_' + string(request.resource.data.luckyNumber))));
      // the owner (same device) may read his own registration — used to stop double registration
      allow get: if isDreamAdmin() || (request.auth != null && resource.data.uid == request.auth.uid);
      allow list, delete: if isDreamAdmin();
    }
    // Email / name locks — one registration per email and per name in each competition
    match /dreamCompEmails/{id} {
      allow get: if true;
      allow list: if isDreamAdmin();
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.regId == dreamMyRegId(request.resource.data.compId)
        && id == request.resource.data.compId + '_' + getAfter(dreamRegPath(request.resource.data.regId)).data.email;
      allow update: if false;
      allow delete: if isDreamAdmin();
    }
    match /dreamCompNames/{id} {
      allow get: if true;
      allow list: if isDreamAdmin();
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid
        && request.resource.data.regId == dreamMyRegId(request.resource.data.compId)
        && id == request.resource.data.compId + '_' + getAfter(dreamRegPath(request.resource.data.regId)).data.nameKey;
      allow update: if false;
      allow delete: if isDreamAdmin();
    }
    // Public participants wall (name, country, photo — no email, phone or lucky number)
    match /dreamCompPublic/{id} {
      allow read: if true;
      allow create: if isDreamAdmin() || (
        request.auth != null && request.resource.data.uid == request.auth.uid
        && id == dreamMyRegId(request.resource.data.compId)
        && request.resource.data.keys().hasOnly(['compId', 'name', 'country', 'photo', 'uid', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && existsAfter(dreamRegPath(id)));
      allow update: if isDreamAdmin() || (
        request.auth != null && resource.data.get('uid', '') == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hasLucky'])
        && request.resource.data.hasLucky == true
        && getAfter(dreamRegPath(id)).data.luckyNumber is int);
      allow delete: if isDreamAdmin();
    }
    // "Try your luck" numbers 1–1000. Doc id = competitionId_number → each number can be claimed once.
    // Contains no name, so visitors only see that a number is taken — never who took it.
    match /dreamLuckyNumbers/{id} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['compId', 'number', 'regId', 'uid', 'createdAt'])
        && request.resource.data.number is int && request.resource.data.number >= 1 && request.resource.data.number <= 1000
        && id == request.resource.data.compId + '_' + string(request.resource.data.number)
        && request.resource.data.regId == dreamMyRegId(request.resource.data.compId)
        && getAfter(dreamRegPath(request.resource.data.regId)).data.luckyNumber == request.resource.data.number;
      allow update, delete: if isDreamAdmin();
    }
    // Leaderboard (public, admin writes)
    match /dreamCompBoard/{id} { allow read: if true; allow write: if isDreamAdmin(); }
    // Admin devices that receive push notifications
    match /dreamAdminTokens/{id} { allow read, write: if isDreamAdmin(); }
    // ---------------- END DREAM ----------------

  }
}
