rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Content: everyone can read, only signed-in admin can write
    match /{col}/{id} {
      allow read: if col in ['episodes','shows','guests','partners','settings'];
      allow write: if request.auth != null;
    }
    // Visitors can send messages & subscribe, only admin can read them
    match /messages/{id} {
      allow create: if request.resource.data.keys().hasAll(['name','email','message'])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() < 3000;
      allow read, update, delete: if request.auth != null;
    }
    match /subscribers/{id} {
      allow create: if request.resource.data.email is string;
      allow read, update, delete: if request.auth != null;
    }
  }
}
