// ============================================================================
//  DREAM MARKET PODCAST — Firestore rules
//  ⚠️  Ha tirtirin rules-ka apps-kaaga kale! Kaliya ku DAR qaybta u dhaxaysa
//      "BEGIN DREAM" iyo "END DREAM" gudaha:  match /databases/{database}/documents { ... }
// ============================================================================
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------- BEGIN DREAM ----------------
    function dreamAdminPath(id) { return /databases/$(database)/documents/admin-dream/$(id); }

    // username + password are compared HERE (server side) — never sent to browsers
    function dreamValidAdmin(id, u, p) {
      return id is string && exists(dreamAdminPath(id))
        && get(dreamAdminPath(id)).data.username == u
        && get(dreamAdminPath(id)).data.password == p;
    }
    function dreamSessionPath() { return /databases/$(database)/documents/dreamAdminSessions/$(request.auth.uid); }
    function isDreamAdmin() {
      return request.auth != null
        && exists(dreamSessionPath())
        && request.time < get(dreamSessionPath()).data.createdAt + duration.value(7, 'd')
        && dreamValidAdmin(get(dreamSessionPath()).data.adminId,
                           get(dreamSessionPath()).data.username,
                           get(dreamSessionPath()).data.password);
    }

    // Admin accounts: edited only from Firebase Console (nobody can read them from the web)
    match /admin-dream/{id} { allow read, write: if false; }

    // Login session (created only when username + password match admin-dream)
    match /dreamAdminSessions/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.createdAt == request.time
        && dreamValidAdmin(request.resource.data.adminId, request.resource.data.username, request.resource.data.password);
      allow read, delete: if request.auth != null && request.auth.uid == uid;
    }

    // Website content: everyone reads, only admin writes
    match /dreamSettings/{id}  { allow read: if true; allow write: if isDreamAdmin(); }
    match /dreamEpisodes/{id}  { allow read: if true; allow write: if isDreamAdmin(); }
    match /dreamShows/{id}     { allow read: if true; allow write: if isDreamAdmin(); }
    match /dreamGuests/{id}    { allow read: if true; allow write: if isDreamAdmin(); }
    match /dreamPartners/{id}  { allow read: if true; allow write: if isDreamAdmin(); }
    match /dreamTeam/{id}      { allow read: if true; allow write: if isDreamAdmin(); }

    // Visitors send messages / subscribe; only admin reads them
    match /dreamMessages/{id} {
      allow create: if request.resource.data.message is string && request.resource.data.message.size() < 3000
                    && request.resource.data.email is string;
      allow read, update, delete: if isDreamAdmin();
    }
    match /dreamSubscribers/{id} {
      allow create: if request.resource.data.email is string && request.resource.data.email.size() < 200;
      allow read, delete: if isDreamAdmin();
    }
    // Visitor statistics: the website adds counts; counts are public (shown on the homepage)
    match /dreamStats/{id} {
      allow read: if true;
      allow create, update: if (id == 'total' || id.matches('day-[0-9]{4}-[0-9]{2}-[0-9]{2}'))
        && request.resource.data.keys().hasOnly(['date', 'visits', 'visitors', 'pageviews', 'mobile', 'desktop', 'sources', 'pages', 'updatedAt']);
      allow delete: if isDreamAdmin();
    }
    // ---------- Competitions ----------
    match /dreamCompetitions/{id} {
      allow read: if true;
      allow create, delete: if isDreamAdmin();
      // admin edits everything; a visitor may only add +1 to "registered" while registration is open and not full
      allow update: if isDreamAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registered'])
        && request.resource.data.registered == resource.data.get('registered', 0) + 1
        && resource.data.get('registrationOpen', false) == true
        && (resource.data.get('maxParticipants', 0) == 0 || request.resource.data.registered <= resource.data.maxParticipants));
    }
    // Registrations (private). Document id = competitionId_email, so the same email cannot register twice.
    match /dreamCompRegs/{id} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.agreed == true
        && request.resource.data.fullName is string && request.resource.data.fullName.size() > 1 && request.resource.data.fullName.size() < 100
        && request.resource.data.email is string && request.resource.data.email.size() < 160
        && request.resource.data.compId is string
        && id.matches(request.resource.data.compId + '_.+')
        && get(/databases/$(database)/documents/dreamCompetitions/$(request.resource.data.compId)).data.get('registrationOpen', false) == true;
      allow read, update, delete: if isDreamAdmin();
    }
    // Leaderboard (public, admin writes)
    match /dreamCompBoard/{id} { allow read: if true; allow write: if isDreamAdmin(); }
    // ---------------- END DREAM ----------------

  }
}
